  "failure_policy": [
    "A scheduler transport failure may route to Incident & Repair.",
    "Missing evidence produces BLOCKED, not Incident.",
    "No automatic retry may exceed the workflow retry budget.",
    "No scheduled task may publish, spend, order, pay, contact a customer, or deploy without its normal Owner Gate."
  ]
