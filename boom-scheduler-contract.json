      "status": "PRESERVED_NOT_ACTIVATED"
    },
    {
      "id": "site_reliability_legacy_30m",
      "source": "legacy manager site-reliability",
      "schedule": "*/30 * * * *",
      "owner": "learning_governance_brain",
      "operation": "OBSERVE_AND_INCIDENT_ROUTE",
      "status": "PRESERVED_NOT_ACTIVATED"
    },
    {
      "id": "shelf_coverage_17x1000",
      "source": "new Automation Control Plane",
      "schedule": null,
      "owner": "commerce_truth_brain",
      "operation": "READ_ONLY_AUDIT",
      "status": "UNSCHEDULED_UNTIL_N8N_SHADOW_PROOF"
    },
    {
      "id": "f60t_live_world_radar",
      "source": "existing skill",
      "schedule": null,
      "owner": "intelligence_brain",
      "operation": "OBSERVE_ONLY",
