      "reason",
      "affected_components",
      "tests",
      "fallback"
    ],
    "owner_gate_for_material_behavior_change": true
  },
  "knowledge_policy": {
    "durable": [
      "architecture",
      "approved_product_rules",
      "owner_gates",
      "project_decisions"
    ],
    "volatile": [
      "prices",
      "stock",
      "shipping",
      "supplier_terms",
      "laws",
      "model_capabilities",
      "market_trends"
    ],
    "volatile_requires_live_verification": true,
    "never_present_stale_as_current": true
  }
