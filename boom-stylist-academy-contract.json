  "objective": "Train BOOM to understand style and visual merchandising, then prove it in repeatable shadow exams before influencing HUNT shelves.",
  "tracks": [
    {
      "id": "S1",
      "name": "Style Foundations",
      "modules": [
        "color harmony",
        "garment attributes",
        "silhouette as garment shape",
        "layering",
        "occasion matching",
        "season/context",
        "accessory pairing",
        "complete-the-look"
      ]
    },
    {
      "id": "S2",
      "name": "AI Style Intelligence",
      "modules": [
        "visual style tagging",
        "text-to-style taxonomy",
        "product similarity",
        "outfit composition",
        "Taste DNA adaptation",
        "explainable recommendations",
        "trend/context signals",
        "confidence and abstention"
      ]
    },
    {
      "id": "S3",
      "name": "HUNT Brand DNA",
      "modules": [
        "clean premium language",
        "recognizable HUNT identity",
        "collection coherence",
        "brand yes/no examples",
        "owner feedback learning"
      ]
    },
    {
      "id": "M1",
      "name": "Shelf & Visual Merchandising",
      "modules": [
        "hero-anchor-support hierarchy",
        "color rhythm",
        "category grouping",
        "price ladder",
        "newness rotation",
        "complete-the-look adjacency",
        "visual density",
        "mobile vs desktop composition"
      ]
    },
    {
      "id": "M2",
      "name": "Commercial Shelf Truth",
      "modules": [
        "verified stock only",
        "country shipping eligibility",
        "price/profit gates",
        "variant truth",
        "market availability",
        "blocked-item suppression",
        "recheck-before-checkout"
      ]
    },
    {
      "id": "L1",
      "name": "Learning Loop",
      "modules": [
        "owner approve/reject labels",
        "reason codes",
        "aggregate click/save/cart/purchase signals",
        "return/cancel signals when available",
        "A/B shadow comparisons",
        "regression tests"
      ]
    }
  ],
  "safety_and_trust": [
    "Do not critique or rank a person's body.",
    "Do not infer sensitive traits from appearance.",
    "Style recommendations use stated preferences, fit/size data, context, product attributes and Taste DNA.",
    "Do not expose unverified products, variants, prices, stock or shipping.",
    "Do not autonomously publish, reorder Production shelves or change prices.",
    "When confidence is low, abstain or ask for more context instead of inventing certainty."
  ],
  "shelf_roles": [
    "hero",
    "anchor",
    "support",
    "complete_the_look",
    "accessory",
    "entry_price",
    "premium_step_up",
    "discovery"
  ],
  "exams": [
    {
      "id": "STYLE-20-5",
      "name": "20 Products → 5 Looks",
      "input_rule": "20 Product Truth verified products",
      "output_rule": "5 coherent looks with product IDs, rationale and confidence",
      "scoring": {
        "style_coherence": 25,
        "product_truth": 20,
        "variety": 15,
        "hunt_brand_fit": 15,
        "practicality": 15,
        "explanation": 10
      },
      "pass_score": 85
    },
    {
      "id": "SHELF-24",
      "name": "24 Products → Shelf Composition",
      "input_rule": "24 Product Truth verified products",
      "output_rule": "ordered shelf with hero/anchor/support roles and mobile/desktop variants",
      "scoring": {
        "visual_hierarchy": 20,
        "product_truth": 20,
        "category_coherence": 15,
        "color_rhythm": 10,
        "commercial_balance": 15,
        "discovery_diversity": 10,
        "responsive_composition": 10
      },
      "pass_score": 85
    },
    {
      "id": "COMBINED-LOOK-SHELF",
      "name": "Look → Shelf → Commercial Truth",
      "input_rule": "one selected look plus complementary verified catalog",
      "output_rule": "hero shelf, complete-the-look rail and reasoning without changing Production",
      "scoring": {
        "cross_surface_consistency": 20,
        "product_truth": 25,
        "brand_fit": 15,
        "merchandising_quality": 20,
        "commercial_sanity": 10,
        "explainability": 10
      },
      "pass_score": 85
    }
  ],
  "mastery": [
